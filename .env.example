# Copy this file to .env and fill in ONE of the two options below.
# .env is git-ignored.

# ---------------------------------------------------------------------------
# Option A - OpenAI directly. Keys start with "sk-".
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Option B - Azure OpenAI (typical for a corporate-issued key, which is a
# 32-character hex string rather than an "sk-" key). Set all three:
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=your-32-char-azure-key
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Access gate. The default password in app/auth.py is committed to a public
# repository, so any instance that should actually be closed sets its own here.
# APP_SECRET signs the session cookie; leave it unset locally and a fresh one is
# generated at startup, which signs everyone out on restart.
APP_PASSWORD=
APP_SECRET=
